# Enforce LF line endings for shell scripts (required on Linux/macOS)
*.sh text eol=lf

# Rust source and config
*.rs text eol=lf
*.toml text eol=lf
# Lockfiles are read by `cargo`, diffed in review, and hashed by CI. Letting
# autocrlf rewrite every line of one turns a dependency bump into a 19 000-line
# diff and makes two checkouts of one commit look different to any byte-level
# check.
Cargo.lock text eol=lf

# Protobuf
*.proto text eol=lf

# PowerShell (cross-platform)
*.ps1 text eol=lf

# Build/dev scripts
*.bat text eol=crlf

# All source code — LF everywhere
# All source code — LF everywhere
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.vue text eol=lf
*.svelte text eol=lf
