    "dev": "vite",
    "core:build:debug": "node ../../dev/ort_env.js cargo build --manifest-path ../../core/Cargo.toml -p acowork-gateway -p acowork-runtime -p acowork-embed -p acowork-lsp-relay -p acowork-node -p acowork-pm -p acowork-user -p acowork-doc -p acowork-memory",
