# Signing keys — generated per machine by `acowork-keygen` (dev/common/build-agent.*).
# Never commit: the developer key signs local dev packages, and the whole
# directory is reproducible from `acowork-keygen --type developer`.
examples/.signing-keys/
agents/.signing-keys/

# Local scratch at the repo root (probe/debug scripts)
dev-tmp/
